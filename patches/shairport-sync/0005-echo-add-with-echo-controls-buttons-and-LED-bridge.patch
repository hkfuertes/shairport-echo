+#include "echo_controls_bridge.h"
+#endif
 
 #include <echo_alsa.h>
 #include <errno.h>
@@ -46,6 +49,46 @@ static int close_device(void) {
   return rc;
 }
 
+#ifdef CONFIG_ECHO_CONTROLS
+/*
+ * The controls bridge is intentionally the only caller of these helpers. It reads and adjusts
+ * the same ALSA mixer owned by this backend, rather than keeping a second volume value.
+ */
+int echo_audio_get_volume_db(double *out) {
+  if (out == NULL)
+    return -EINVAL;
+  pthread_mutex_lock(&echo_mutex);
+  int rc = (echo_device != NULL) ? echo_alsa_get_volume_db(echo_device, out)
+                                 : echo_alsa_read_system_volume_db(out);
+  pthread_mutex_unlock(&echo_mutex);
+  return rc;
+}
+
+int echo_audio_read_system_volume_db(double *out) {
+  if (out == NULL)
+    return -EINVAL;
+  pthread_mutex_lock(&echo_mutex);
+  int rc = (echo_device != NULL) ? echo_alsa_get_volume_db(echo_device, out)
+                                 : echo_alsa_read_system_volume_db(out);
+  pthread_mutex_unlock(&echo_mutex);
+  return rc;
+}
+
+int echo_audio_adjust_volume_db(int steps, double *out) {
+  if (out == NULL)
+    return -EINVAL;
+  pthread_mutex_lock(&echo_mutex);
+  int rc = (echo_device != NULL) ? echo_alsa_adjust_volume_db(echo_device, steps, out)
+                                 : echo_alsa_adjust_system_volume_db(steps, out);
+  if (rc == 0) {
+    echo_volume = *out * 100.0;
+    echo_volume_set = 1;
+  }
+  pthread_mutex_unlock(&echo_mutex);
+  return rc;
+}
+#endif
+
