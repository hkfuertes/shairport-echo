 ap2_event_receiver.c   |   6 +
 audio_echo.c           |  57 ++++++-
 configure.ac           |   8 +
 echo_controls_bridge.c | 376 +++++++++++++++++++++++++++++++++++++++++
 echo_controls_bridge.h |   9 +
 6 files changed, 459 insertions(+), 2 deletions(-)
 create mode 100644 echo_controls_bridge.c
 create mode 100644 echo_controls_bridge.h

