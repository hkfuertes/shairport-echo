new file mode 100644
index 0000000..ddda5e4
--- /dev/null
+++ b/echo_controls_bridge.h
@@ -0,0 +1,8 @@
+#ifndef ECHO_CONTROLS_BRIDGE_H
+#define ECHO_CONTROLS_BRIDGE_H
+
+int echo_controls_start(void);
+void echo_controls_stop(void);
+void echo_controls_show_volume(double db);
+
+#endif
