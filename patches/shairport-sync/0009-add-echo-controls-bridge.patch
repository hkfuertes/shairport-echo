diff --git a/echo_controls_bridge.c b/echo_controls_bridge.c
new file mode 100644
index 0000000..975c9e0
--- /dev/null
+++ b/echo_controls_bridge.c
@@ -0,0 +1,254 @@
+/* Echo button and LED policy using the separate libecho_controls.a hardware ABI. */
+
+#include "echo_controls_bridge.h"
+
+#include "ap2_event_message_handler.h"
+#include "common.h"
+#include "player.h"
+
+#include <echo_controls.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+
+#define ECHO_CONTROLS_ACTION_WINDOW_NS 350000000ULL
+#define ECHO_CONTROLS_VOLUME_REPEAT_NS 200000000ULL
+#define ECHO_CONTROLS_VOLUME_MIN_DB -30.0
+#define ECHO_CONTROLS_VOLUME_MAX_DB 0.0
+#define ECHO_CONTROLS_PLAY_PAUSE 2U
+#define ECHO_CONTROLS_NEXT_ITEM 4U
+
+extern rtsp_conn_info *principal_conn;
+extern pthread_rwlock_t principal_conn_lock;
+
+static pthread_mutex_t controls_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t controls_thread;
+static int controls_started = 0;
+static int controls_running = 0;
+static int controls_thread_active = 0;
+static echo_controls_ring_t *ring = NULL;
+static echo_controls_buttons_t *buttons[2] = {NULL, NULL};
+static uint64_t action_release_ns = 0;
+static uint64_t last_volume_change_ns[2] = {0, 0};
+
+static int controls_are_running(void) {
+  pthread_mutex_lock(&controls_mutex);
+  int running = controls_running;
+  pthread_mutex_unlock(&controls_mutex);
+  return running;
+}
+
+static void send_remote_command(unsigned int command) {
+#ifdef CONFIG_AIRPLAY_2
+  pthread_rwlock_rdlock(&principal_conn_lock);
+  if ((principal_conn != NULL) && (principal_conn->airplay_type == ap_2)) {
+    ssize_t result = ap2_event_send_modern_media_remote_command(principal_conn, command);
+    if (result <= 0)
+      debug(1, "echo-controls: AP2 command %u failed: %zd", command, result);
+  } else {
+    debug(2, "echo-controls: no active AP2 session for command %u", command);
+  }
+  pthread_rwlock_unlock(&principal_conn_lock);
+#else
+  (void)command;
+#endif
+}
+
+static void change_volume(int direction) {
+#ifdef CONFIG_AIRPLAY_2
+  pthread_rwlock_rdlock(&principal_conn_lock);
+  if ((principal_conn != NULL) && (principal_conn->airplay_type == ap_2)) {
+    double target = config.airplay_volume;
+    if (target <= -144.0) {
+      if (direction > 0)
+        target = ECHO_CONTROLS_VOLUME_MIN_DB + 1.0;
+      else {
+        pthread_rwlock_unlock(&principal_conn_lock);
+        return;
+      }
+    } else {
+      target += direction;
+      if (target < ECHO_CONTROLS_VOLUME_MIN_DB)
+        target = ECHO_CONTROLS_VOLUME_MIN_DB;
+      if (target > ECHO_CONTROLS_VOLUME_MAX_DB)
+        target = ECHO_CONTROLS_VOLUME_MAX_DB;
+    }
+    if (target != config.airplay_volume) {
+      // player_volume drives the selected audio backend, preserving its sole mixer path.
+      player_volume(target, principal_conn);
+      ssize_t result = ap2_event_send_unit_volume_notification(
+          principal_conn, (target - ECHO_CONTROLS_VOLUME_MIN_DB) /
+                              (ECHO_CONTROLS_VOLUME_MAX_DB - ECHO_CONTROLS_VOLUME_MIN_DB));
+      if (result <= 0)
+        debug(1, "echo-controls: AP2 volume notification failed: %zd", result);
+    }
+  } else {
+    debug(2, "echo-controls: no active AP2 session for volume change");
+  }
+  pthread_rwlock_unlock(&principal_conn_lock);
+#else
+  (void)direction;
+#endif
+}
+
+static void handle_button(const echo_controls_button_event_t *event, uint64_t now) {
+  if (event->button == ECHO_CONTROLS_BUTTON_ACTION) {
+    if (event->state != ECHO_CONTROLS_BUTTON_RELEASED)
+      return;
+    if ((action_release_ns != 0) && (now - action_release_ns <= ECHO_CONTROLS_ACTION_WINDOW_NS)) {
+      action_release_ns = 0;
+      send_remote_command(ECHO_CONTROLS_NEXT_ITEM);
+    } else {
+      action_release_ns = now;
+    }
+    return;
+  }
+
+  int direction = 0;
+  size_t index = 0;
+  if (event->button == ECHO_CONTROLS_BUTTON_VOLUME_UP) {
+    direction = 1;
+    index = 1;
+  } else if (event->button == ECHO_CONTROLS_BUTTON_VOLUME_DOWN) {
+    direction = -1;
+  }
+  if ((direction != 0) && (event->state != ECHO_CONTROLS_BUTTON_RELEASED) &&
+      ((now - last_volume_change_ns[index]) >= ECHO_CONTROLS_VOLUME_REPEAT_NS)) {
+    last_volume_change_ns[index] = now;
+    change_volume(direction);
+  }
+}
+
+static void dispatch_pending_action(uint64_t now) {
+  if ((action_release_ns != 0) && (now - action_release_ns > ECHO_CONTROLS_ACTION_WINDOW_NS)) {
+    action_release_ns = 0;
+    send_remote_command(ECHO_CONTROLS_PLAY_PAUSE);
+  }
+}
+
+static void close_button(size_t index) {
+  if (buttons[index] != NULL) {
+    echo_controls_buttons_close(buttons[index]);
+    buttons[index] = NULL;
+  }
+}
+
+static void *controls_thread_code(__attribute__((unused)) void *arg) {
+  while (controls_are_running()) {
+    for (size_t index = 0; index < sizeof(buttons) / sizeof(buttons[0]); index++) {
+      while (buttons[index] != NULL) {
+        echo_controls_button_event_t event = {0};
+        int rc = echo_controls_buttons_next(buttons[index], &event);
+        if (rc == -EAGAIN)
+          break;
+        if (rc != 0) {
+          debug(1, "echo-controls: input %zu disabled: %d", index, rc);
+          close_button(index);
+          break;
+        }
+        handle_button(&event, get_monotonic_time_in_ns());
+      }
+    }
+    dispatch_pending_action(get_monotonic_time_in_ns());
+    usleep(20000);
+  }
+  return NULL;
+}
+
+int echo_controls_start(void) {
+  static const char *paths[] = {"/dev/input/event2", "/dev/input/event1"};
+
+  pthread_mutex_lock(&controls_mutex);
+  if (controls_started) {
+    pthread_mutex_unlock(&controls_mutex);
+    return 0;
+  }
+
+  int rc = echo_controls_ring_open_default(&ring);
+  if (rc != 0) {
+    debug(1, "echo-controls: LED ring unavailable: %d", rc);
+    ring = NULL;
+  }
+  for (size_t index = 0; index < sizeof(buttons) / sizeof(buttons[0]); index++) {
+    rc = echo_controls_buttons_open(paths[index], 1, &buttons[index]);
+    if (rc != 0) {
+      debug(2, "echo-controls: input %s unavailable: %d", paths[index], rc);
+      buttons[index] = NULL;
+    }
+  }
+
+  controls_started = 1;
+  controls_running = (buttons[0] != NULL) || (buttons[1] != NULL);
+  if (controls_running) {
+    rc = pthread_create(&controls_thread, NULL, controls_thread_code, NULL);
+    if (rc != 0) {
+      controls_running = 0;
+      close_button(0);
+      close_button(1);
+      if (ring != NULL) {
+        echo_controls_ring_close(ring);
+        ring = NULL;
+      }
+      controls_started = 0;
+      pthread_mutex_unlock(&controls_mutex);
+      return -rc;
+    }
+    controls_thread_active = 1;
+  }
+  pthread_mutex_unlock(&controls_mutex);
+  return 0;
+}
+
+void echo_controls_stop(void) {
+  pthread_mutex_lock(&controls_mutex);
+  if (!controls_started) {
+    pthread_mutex_unlock(&controls_mutex);
+    return;
+  }
+  controls_running = 0;
+  int join_thread = controls_thread_active;
+  pthread_mutex_unlock(&controls_mutex);
+
+  if (join_thread)
+    pthread_join(controls_thread, NULL);
+
+  pthread_mutex_lock(&controls_mutex);
+  close_button(0);
+  close_button(1);
+  if (ring != NULL) {
+    echo_controls_ring_close(ring);
+    ring = NULL;
+  }
+  action_release_ns = 0;
+  last_volume_change_ns[0] = 0;
+  last_volume_change_ns[1] = 0;
+  controls_thread_active = 0;
+  controls_started = 0;
+  pthread_mutex_unlock(&controls_mutex);
+}
+
+void echo_controls_show_volume(double db) {
+  uint8_t frame[ECHO_CONTROLS_RING_CHANNELS] = {0};
+  if (db < ECHO_CONTROLS_VOLUME_MIN_DB)
+    db = ECHO_CONTROLS_VOLUME_MIN_DB;
+  if (db > ECHO_CONTROLS_VOLUME_MAX_DB)
+    db = ECHO_CONTROLS_VOLUME_MAX_DB;
+  size_t lit = (size_t)(((db - ECHO_CONTROLS_VOLUME_MIN_DB) * ECHO_CONTROLS_RING_SEGMENTS +
+                         (ECHO_CONTROLS_VOLUME_MAX_DB - ECHO_CONTROLS_VOLUME_MIN_DB) / 2) /
+                        (ECHO_CONTROLS_VOLUME_MAX_DB - ECHO_CONTROLS_VOLUME_MIN_DB));
+  for (size_t index = 0; index < lit; index++) {
+    frame[index * 3 + 0] = 0;
+    frame[index * 3 + 1] = 96;
+    frame[index * 3 + 2] = 255;
+  }
+
+  pthread_mutex_lock(&controls_mutex);
+  if (ring != NULL) {
+    int rc = echo_controls_ring_set_frame(ring, frame, sizeof(frame));
+    if (rc != 0)
+      debug(1, "echo-controls: LED update failed: %d", rc);
+  }
+  pthread_mutex_unlock(&controls_mutex);
+}
