Subject: [PATCH 2/5] ap2: backport reverse event encoders

Backport of the AP2 modern media remote command and unit volume
notification encoders.

Upstream: backport of mikebrady/shairport-sync@441988ce9763062b3fe95c9fd9971ddd457e2466
(development branch, 5.6-dev); drop when rebasing onto 5.6
Signed-off-by: Miguel Fuertes <hkfuertes@users.noreply.github.com>
---
 ap2_event_message_handler.c | 109 ++++++++++++++++++++++++++++++++++++
 1 file changed, 109 insertions(+)

diff --git a/ap2_event_message_handler.c b/ap2_event_message_handler.c
index 457416a..ea42dfe 100644
--- a/ap2_event_message_handler.c
+++ b/ap2_event_message_handler.c
@@ -30,6 +30,8 @@
 #include "utilities/generate_random_uuid.h"
 #include "utilities/structured_buffer.h"
 
+#include <stdio.h>
+
 void decodeAndLogPlist(plist_t plist_to_log) {
   if (plist_to_log != NULL) {
     char *plist_as_string = plist_as_xml_text(plist_to_log);
@@ -137,3 +139,110 @@ ssize_t ap2_event_send_update_info(rtsp_conn_info *conn) {
   }
   return result;
 }
+
+// These AP2 reverse-event encoders are derived from Shairport Sync upstream
+// commit 441988ce9763062b3fe95c9fd9971ddd457e2466. Keep them here because this
+// snapshot already owns the encrypted event-port transport.
+static plist_t echo_ap2_destination_archive(const char *uid) {
+  if (uid == NULL)
+    return NULL;
+
+  plist_t archive = plist_new_dict();
+  plist_dict_set_item(archive, "$version", plist_new_uint(100000));
+  plist_dict_set_item(archive, "$archiver", plist_new_string("NSKeyedArchiver"));
+
+  plist_t root_uid = plist_new_dict();
+  plist_dict_set_item(root_uid, "CF$UID", plist_new_uint(1));
+  plist_t top = plist_new_dict();
+  plist_dict_set_item(top, "root", root_uid);
+  plist_dict_set_item(archive, "$top", top);
+
+  plist_t objects = plist_new_array();
+  plist_array_append_item(objects, plist_new_string("$null"));
+
+  plist_t class_uid = plist_new_dict();
+  plist_dict_set_item(class_uid, "CF$UID", plist_new_uint(3));
+  plist_t element_uid = plist_new_dict();
+  plist_dict_set_item(element_uid, "CF$UID", plist_new_uint(2));
+  plist_t object_values = plist_new_array();
+  plist_array_append_item(object_values, element_uid);
+  plist_t mutable_array = plist_new_dict();
+  plist_dict_set_item(mutable_array, "NS.objects", object_values);
+  plist_dict_set_item(mutable_array, "$class", class_uid);
+  plist_array_append_item(objects, mutable_array);
+
+  plist_array_append_item(objects, plist_new_string(uid));
+  plist_t classes = plist_new_array();
+  plist_array_append_item(classes, plist_new_string("NSMutableArray"));
+  plist_array_append_item(classes, plist_new_string("NSArray"));
+  plist_array_append_item(classes, plist_new_string("NSObject"));
+  plist_t class_definition = plist_new_dict();
+  plist_dict_set_item(class_definition, "$classname", plist_new_string("NSMutableArray"));
+  plist_dict_set_item(class_definition, "$classes", classes);
+  plist_array_append_item(objects, class_definition);
+  plist_dict_set_item(archive, "$objects", objects);
+
+  char *binary = NULL;
+  uint32_t binary_length = 0;
+  plist_to_bin(archive, &binary, &binary_length);
+  plist_free(archive);
+  if (binary == NULL)
+    return NULL;
+  plist_t result = plist_new_data(binary, binary_length);
+  free(binary);
+  return result;
+}
+
+static plist_t echo_ap2_command_params(const char *group_id) {
+  plist_t params = plist_new_dict();
+  char *command_id = generate_random_uuid();
+  plist_t destinations = echo_ap2_destination_archive(group_id);
+  if ((command_id == NULL) || (destinations == NULL)) {
+    free(command_id);
+    if (destinations != NULL)
+      plist_free(destinations);
+    plist_free(params);
+    return NULL;
+  }
+  plist_dict_set_item(params, "kMRMediaRemoteOptionSendOptionsNumber", plist_new_uint(0));
+  plist_dict_set_item(params, "kMRMediaRemoteOptionCommandID", plist_new_string(command_id));
+  free(command_id);
+  plist_dict_set_item(params, "kMRMediaRemoteOptionIsRedirectingCommand", plist_new_bool(1));
+  plist_dict_set_item(params, "kMRMediaRemoteOptionDestinationDeviceUIDs", destinations);
+  return params;
+}
+
+ssize_t ap2_event_send_modern_media_remote_command(rtsp_conn_info *conn,
+                                                   unsigned int command_number) {
+  if ((conn == NULL) || (conn->airplay_gid == NULL))
+    return -1;
+
+  plist_t params = echo_ap2_command_params(conn->airplay_gid);
+  if (params == NULL)
+    return -1;
+  char command[32];
+  snprintf(command, sizeof(command), "%u", command_number);
+  plist_t request = plist_new_dict();
+  plist_dict_set_item(request, "modernMediaRemoteCommand", plist_new_string(command));
+  plist_dict_set_item(request, "type", plist_new_string("sendMediaRemoteCommand"));
+  plist_dict_set_item(request, "params", params);
+  ssize_t result = ap2_event_port_post_command(conn, request);
+  plist_free(request);
+  return result;
+}
+
+ssize_t ap2_event_send_unit_volume_notification(rtsp_conn_info *conn, double volume) {
+  if ((conn == NULL) || (volume < 0.0) || (volume > 1.0))
+    return -1;
+
+  plist_t params = plist_new_dict();
+  plist_dict_set_item(params, "volume", plist_new_real(volume));
+  plist_t request = plist_new_dict();
+  plist_dict_set_item(request, "value", plist_new_string("dvlc"));
+  plist_dict_set_item(request, "volume", plist_new_real(volume));
+  plist_dict_set_item(request, "type", plist_new_string("sendMediaRemoteCommand"));
+  plist_dict_set_item(request, "params", params);
+  ssize_t result = ap2_event_port_post_command(conn, request);
+  plist_free(request);
+  return result;
+}
