diff --git a/audio_echo.c b/audio_echo.c
index bf3c7d2..4fe3520 100644
--- a/audio_echo.c
+++ b/audio_echo.c
@@ -57,10 +57,9 @@ static int close_device(void) {
 int echo_audio_get_volume_db(double *out) {
   if (out == NULL)
     return -EINVAL;
