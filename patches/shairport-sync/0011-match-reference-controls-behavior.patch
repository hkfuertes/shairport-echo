@@ -51,0 +52,33 @@ static int close_device(void) {
+#ifdef CONFIG_ECHO_CONTROLS
+/*
+ * The controls bridge is intentionally the only caller of these helpers. It reads and adjusts
+ * the same ALSA mixer owned by this backend, rather than keeping a second volume value.
+ */
+int echo_audio_get_volume_db(double *out) {
+  if (out == NULL)
+    return -EINVAL;
+  int rc = -ENOTCONN;
+  pthread_mutex_lock(&echo_mutex);
+  if (echo_device != NULL)
+    rc = echo_alsa_get_volume_db(echo_device, out);
+  pthread_mutex_unlock(&echo_mutex);
+  return rc;
+}
+
+int echo_audio_adjust_volume_db(int steps, double *out) {
+  if (out == NULL)
+    return -EINVAL;
+  int rc = -ENOTCONN;
+  pthread_mutex_lock(&echo_mutex);
+  if (echo_device != NULL) {
+    rc = echo_alsa_adjust_volume_db(echo_device, steps, out);
+    if (rc == 0) {
+      echo_volume = *out * 100.0;
+      echo_volume_set = 1;
+    }
+  }
+  pthread_mutex_unlock(&echo_mutex);
+  return rc;
+}
+#endif
+
