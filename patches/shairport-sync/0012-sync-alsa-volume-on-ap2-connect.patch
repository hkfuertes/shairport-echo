diff --git a/audio_echo.c b/audio_echo.c
index de9780e..bf3c7d2 100644
--- a/audio_echo.c
+++ b/audio_echo.c
@@ -67,0 +68,10 @@ int echo_audio_get_volume_db(double *out) {
+int echo_audio_read_system_volume_db(double *out) {
+  if (out == NULL)
+    return -EINVAL;
+  pthread_mutex_lock(&echo_mutex);
+  int rc = (echo_device != NULL) ? echo_alsa_get_volume_db(echo_device, out)
+                                 : echo_alsa_read_system_volume_db(out);
+  pthread_mutex_unlock(&echo_mutex);
+  return rc;
+}
+
diff --git a/echo_controls_bridge.c b/echo_controls_bridge.c
index f2d6181..750eeab 100644
--- a/echo_controls_bridge.c
+++ b/echo_controls_bridge.c
@@ -32,0 +33 @@ extern int echo_audio_get_volume_db(double *out);
+extern int echo_audio_read_system_volume_db(double *out);
@@ -73 +73,0 @@ static void send_remote_command(unsigned int command) {
-static void notify_source_volume(double db) {
@@ -74,0 +75 @@ static void notify_source_volume(double db) {
+static ssize_t send_source_volume(rtsp_conn_info *conn, double db) {
@@ -78,0 +80,6 @@ static void notify_source_volume(double db) {
+  return ap2_event_send_unit_volume_notification(conn, unit_volume);
+}
+#endif
+
+static void notify_source_volume(double db) {
+#ifdef CONFIG_AIRPLAY_2
@@ -81 +88 @@ static void notify_source_volume(double db) {
-    ssize_t result = ap2_event_send_unit_volume_notification(principal_conn, unit_volume);
+    ssize_t result = send_source_volume(principal_conn, db);
@@ -92,0 +100,30 @@ static void notify_source_volume(double db) {
+int echo_controls_sync_volume_on_connect(int connection_number) {
+#ifdef CONFIG_AIRPLAY_2
+  double db = 0.0;
+  int rc = echo_audio_read_system_volume_db(&db);
+  if (rc != 0) {
+    debug(1, "echo-controls: ALSA initial-volume read failed: %d", rc);
+    return rc;
+  }
+
+  pthread_rwlock_rdlock(&principal_conn_lock);
+  if ((principal_conn == NULL) || (principal_conn->connection_number != connection_number) ||
+      (principal_conn->airplay_type != ap_2)) {
+    rc = -ENOTCONN;
+  } else {
+    ssize_t result = send_source_volume(principal_conn, db);
+    rc = (result > 0) ? 0 : -EIO;
+  }
+  pthread_rwlock_unlock(&principal_conn_lock);
+
+  if (rc != 0)
+    debug(1, "echo-controls: initial AP2 volume notification failed: %d", rc);
+  else
+    debug(2, "echo-controls: sent initial ALSA volume %.2f dB", db);
+  return rc;
+#else
+  (void)connection_number;
+  return -ENOTSUP;
+#endif
+}
+
