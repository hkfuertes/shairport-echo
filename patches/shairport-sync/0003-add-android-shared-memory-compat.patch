--- a/android-shm-compat.h
+++ b/android-shm-compat.h
@@ -0,0 +1,31 @@
+#ifndef SHAIRPORT_ANDROID_SHM_COMPAT_H
+#define SHAIRPORT_ANDROID_SHM_COMPAT_H
+
+#ifdef __ANDROID__
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#define SHAIRPORT_SHM_DIRECTORY "/dev/shm"
+#define SHAIRPORT_SHM_PATH_MAX 256
+
+static inline int shairport_shm_open(const char *name, int oflag, mode_t mode) {
+  char path[SHAIRPORT_SHM_PATH_MAX];
+  if (name == NULL || name[0] != '/' || name[1] == '\0' || strchr(name + 1, '/') != NULL) {
+    errno = EINVAL;
+    return -1;
+  }
+  int written = snprintf(path, sizeof(path), SHAIRPORT_SHM_DIRECTORY "%s", name);
+  if (written < 0 || written >= (int)sizeof(path)) {
+    errno = ENAMETOOLONG;
+    return -1;
+  }
+  return open(path, oflag, mode);
+}
+#define shm_open shairport_shm_open
+#endif
+
+#endif
