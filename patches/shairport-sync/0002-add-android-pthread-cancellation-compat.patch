+#ifdef __ANDROID__
+static pthread_once_t android_cancel_once = PTHREAD_ONCE_INIT;
+static __thread volatile sig_atomic_t android_cancel_requested;
+
+static void android_cancel_handler(int signal_number) {
+  (void)signal_number;
+  android_cancel_requested = 1;
+}
+
+static void android_cancel_init(void) {
+  struct sigaction action;
+  memset(&action, 0, sizeof(action));
+  action.sa_handler = android_cancel_handler;
+  sigemptyset(&action.sa_mask);
+  sigaction(SIGUSR1, &action, NULL);
+}
+
+int shairport_pthread_cancel(pthread_t thread) {
+  // ponytail: cooperative SIGUSR1 cancellation; use native Bionic cancellation if it becomes available.
+  int rc = pthread_once(&android_cancel_once, android_cancel_init);
+  if (rc)
+    return rc;
+  return pthread_kill(thread, SIGUSR1);
+}
+
+void shairport_pthread_testcancel(void) {
+  if (android_cancel_requested)
+    pthread_exit(NULL);
+}
+
+int shairport_pthread_setcancelstate(int state, int *old_state) {
+  (void)state;
+  if (old_state)
+    *old_state = 0;
+  return 0;
+}
+
+int shairport_pthread_attr_setinheritsched(pthread_attr_t *attr, int inherit) {
+  (void)attr;
+  (void)inherit;
+  return 0;
+}
+#endif
+
