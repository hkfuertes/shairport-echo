+static void mdns_tinysvcmdns_register_service(const char *name, const char *regtype, int port,
+                                              char **txt_records) {
+  char *extendedregtype = malloc(strlen(regtype) + strlen(".local") + 1);
+  if (extendedregtype == NULL)
+    die("tinysvcmdns: could not allocate memory to request a Zeroconf service");
+  strcpy(extendedregtype, regtype);
+  strcat(extendedregtype, ".local");
+  struct mdns_service *svc = mdnsd_register_svc(svr, name, extendedregtype, port, NULL,
+                                                (const char **)txt_records);
+  mdns_service_destroy(svc);
+  free(extendedregtype);
+}
