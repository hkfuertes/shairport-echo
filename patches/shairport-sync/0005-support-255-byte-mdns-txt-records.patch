Allow DNS TXT character-strings up to their protocol limit of 255 bytes instead of the 63-byte DNS-label limit.

--- a/tinysvcmdns.c
+++ b/tinysvcmdns.c
@@ -185,6 +185,22 @@
   return len;
 }
 
+// creates one DNS TXT character-string (maximum 255 bytes).
+uint8_t *create_txt_label(const char *txt) {
+  if (txt == NULL)
+    return NULL;
+  size_t len = strlen(txt);
+  if (len > 255)
+    die("mDNS TXT record is longer than 255 bytes");
+  uint8_t *s = malloc(len + 2);
+  if (s == NULL)
+    die("can not allocate memory for mDNS TXT record");
+  s[0] = (uint8_t)len;
+  memcpy(s + 1, txt, len);
+  s[len + 1] = '\0';
+  return s;
+}
+
 // creates a label
 // free() after use
 uint8_t *create_label(const char *txt) {
@@ -541,7 +557,7 @@
 
   // is current data filled?
   if (txt_rec->txt == NULL) {
-    txt_rec->txt = create_label(txt);
+    txt_rec->txt = create_txt_label(txt);
     return;
   }
 
@@ -553,7 +569,7 @@
   txt_rec->next = malloc(sizeof(struct rr_data_txt));
 
   txt_rec = txt_rec->next;
-  txt_rec->txt = create_label(txt);
+  txt_rec->txt = create_txt_label(txt);
   txt_rec->next = NULL;
 }
